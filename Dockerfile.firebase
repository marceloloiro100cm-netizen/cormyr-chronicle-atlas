# Isolated Cloud Run image for the native TanStack/Nitro build.
# No deploy occurs from building the image.
FROM oven/bun:1.3.3 AS build
WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .
ENV NITRO_PRESET=node_server
RUN bunx vite build --config vite.firebase.config.ts
RUN test -f .output/server/index.mjs && test -d .output/public

FROM node:24-slim
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=8080
WORKDIR /app
COPY --from=build --chown=node:node /app/.output /app/.output
USER node
EXPOSE 8080
CMD ["node", ".output/server/index.mjs"]
