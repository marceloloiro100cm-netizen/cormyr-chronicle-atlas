# Public template only. Real credentials belong to the hosting environment.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: existing Narrator account identifier for the verification-only script
ADMIN_SETUP_USER_ID=
# Server-only integrations (never expose with VITE_)
# Google Drive/Docs direto, sem intermediário. Use UMA das opções:
#  a) Conta de serviço (compartilhe as pastas com o e-mail dela): JSON completo em uma linha
GOOGLE_SERVICE_ACCOUNT_JSON=
#  b) Conta Google do Narrador via OAuth (mantém o acesso atual às pastas)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Segredo Bearer dos callbacks agendados (Cloud Scheduler), com rotação opcional
CRON_SECRET=
CRON_SECRET_PREVIOUS=
# Somente para migrações Drizzle locais
DATABASE_URL=
