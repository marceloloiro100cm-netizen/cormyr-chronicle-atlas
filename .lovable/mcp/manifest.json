{
  "version": 1,
  "sdk_version": "3.3.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qkdznngbkwodsbpkpoax.supabase.co/auth/v1",
    "require_oauth_client_claim": true,
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "cormyr-chronicle-atlas",
      "version": "0.1.0",
      "title": "Cormyr Chronicle Atlas"
    },
    "tools": [
      {
        "name": "opcoes_missivas",
        "title": "Cadastros para missivas",
        "description": "Lista as casas destinatárias. Jogadores também podem escolher narrador=true na ferramenta escrever_missiva para NPCs; a consulta nunca oferece destinatários individuais.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_casas",
        "title": "Listar casas da temporada",
        "description": "Lista as oito casas nobres oficiais da segunda temporada de Cormyr, com lorde, castelo e região.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_documentos",
        "title": "Listar documentos das casas",
        "description": "Lista os documentos da campanha que o usuário conectado pode ver, com título, casa, tipo e versão.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "casa": {
              "description": "Identificador da casa para filtrar, por exemplo \"ashkar\".",
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "ler_documento",
        "title": "Ler documento",
        "description": "Lê o conteúdo completo de um documento da campanha pelo seu identificador.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identificador do documento, obtido em listar_documentos."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "editar_documento",
        "title": "Editar documento",
        "description": "Salva uma nova versão de um documento da campanha. Exige a versão atual para evitar sobrescrever edições de outra pessoa; o histórico de versões é preservado.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identificador do documento."
            },
            "titulo": {
              "type": "string",
              "minLength": 1,
              "description": "Título do documento."
            },
            "conteudo": {
              "type": "string",
              "minLength": 1,
              "description": "Novo conteúdo completo do documento."
            },
            "versao": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991,
              "description": "Versão atual do documento, obtida em ler_documento."
            }
          },
          "required": [
            "id",
            "titulo",
            "conteudo",
            "versao"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "listar_missivas",
        "title": "Listar missivas",
        "description": "Pesquisa missivas e respostas autorizadas, com paginação, semana de atividade e vínculos com corte e unidades.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "casa": {
              "type": "string"
            },
            "origem": {
              "type": "string"
            },
            "membro_corte": {
              "description": "Chave casa:id ou none para sem vínculo.",
              "type": "string"
            },
            "unidade_militar": {
              "description": "Chave casa:id ou none para sem vínculo.",
              "type": "string"
            },
            "semana": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "texto": {
              "type": "string"
            },
            "pagina": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "escrever_missiva",
        "title": "Escrever missiva",
        "description": "Envia missivas para casas nobres ou, quando remetente é jogador, diretamente ao Narrador para contato com NPCs. Cartas entre casas ficam visíveis ao Narrador sem cópia duplicada.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data_campanha": {
              "type": "string",
              "description": "Data de Harptos obrigatória: AAAA-MM-DD, dias 01–30, ou AAAA-F-midwinter/greengrass/midsummer/shieldmeet/highharvestide/feast-moon. Shieldmeet apenas em anos divisíveis por 4."
            },
            "chave_envio": {
              "description": "UUID opcional para uma nova operação; se ausente a ferramenta deriva uma chave determinística, segura para retentativas.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "casa_remetente": {
              "type": "string"
            },
            "casas": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "narrador": {
              "description": "Apenas jogadores: envia exclusivamente ao Narrador; não combine com casas.",
              "type": "boolean"
            },
            "assunto": {
              "type": "string",
              "minLength": 1
            },
            "conteudo": {
              "type": "string",
              "minLength": 1
            },
            "membro_corte": {
              "type": "string"
            },
            "unidade_militar": {
              "type": "string"
            },
            "responsabilidade": {
              "type": "string",
              "enum": [
                "executor",
                "order_recipient"
              ]
            },
            "assinado_por": {
              "description": "NPC ou cargo diegético, disponível somente ao Narrador.",
              "type": "string",
              "maxLength": 120
            },
            "rascunho": {
              "type": "boolean"
            },
            "numero": {
              "description": "Semana de entrega, usada pelo Narrador; não é um número individual da mensagem.",
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "data_campanha",
            "assunto",
            "conteudo"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "responder_missiva",
        "title": "Responder missiva",
        "description": "Responde a uma missiva ou resposta específica. A entrega segue a semana calculada no servidor; só respostas entregues contam como respondidas. Repita a mesma chave e o mesmo texto em caso de falha de rede.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "data_campanha": {
              "type": "string",
              "description": "Data de Harptos obrigatória: AAAA-MM-DD, dias 01–30, ou AAAA-F-midwinter/greengrass/midsummer/shieldmeet/highharvestide/feast-moon. Shieldmeet apenas em anos divisíveis por 4."
            },
            "missiva_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "resposta_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "chave_envio": {
              "description": "Chave de envio opcional para retentativas.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "rascunho": {
              "type": "boolean"
            },
            "assinado_por": {
              "description": "Nome do NPC remetente, somente Narrador.",
              "type": "string",
              "maxLength": 120
            },
            "conteudo": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "data_campanha",
            "missiva_id",
            "conteudo"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
